<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>PIXEL NIGHT DRIVE — TURBO EDITION</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none}
html,body{height:100%}
body{margin:0;background:#050511;color:#fff;font-family:Arial,Helvetica,sans-serif;overflow:hidden;touch-action:none}
#game{position:fixed;inset:0;width:100vw;height:100dvh;display:block;background:#070719;image-rendering:pixelated;object-fit:contain}
.screen{position:fixed;inset:0;display:flex;flex-direction:column;justify-content:flex-start;align-items:center;-webkit-overflow-scrolling:touch;background:rgba(4,4,20,.93);padding:14px;text-align:center;z-index:10;overflow-y:auto}
.hidden{display:none!important}
h1{color:#00f6ff;text-shadow:0 0 12px #00d9ff;font-size:clamp(22px,4.5vw,40px);margin:0 0 6px}
h2{color:#ffd700;margin:8px 0;font-size:clamp(15px,3vw,21px);text-shadow:0 0 8px #ffaa00}
.subtitle{color:#b8b8d7;margin:0 0 10px;font-size:13px}
.stats-bar{display:flex;gap:14px;justify-content:center;align-items:center;margin-bottom:8px;flex-wrap:wrap;background:#0a0a22;border:2px solid #34345c;border-radius:10px;padding:6px 14px;font-size:14px}
.stat{display:flex;align-items:center;gap:6px}
.stat .icon{font-size:18px}
.stat .value{color:#ffd700;font-weight:bold;font-size:16px}
.stat .value.level{color:#00f6ff}
#cars{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:8px;width:min(900px,100%);margin-bottom:10px}
.car-card{min-width:0;border:2px solid #34345c;background:#101029;border-radius:10px;padding:6px 4px;cursor:pointer;position:relative;transition:all .15s}
.car-card.selected{border-color:#00f6ff;box-shadow:0 0 15px #00d9ff66}
.car-card canvas{display:block;width:100%;height:56px;margin-top:2px}
.car-name{font-size:clamp(9px,1.7vw,12px);font-weight:bold;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.car-status{font-size:clamp(9px,1.8vw,12px);font-weight:bold;margin-top:1px}
.car-status.owned{color:#6bffab}
.car-status.locked{color:#ffd700}
#tracks{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-bottom:8px}
.track-btn{padding:8px 12px;font-size:12px;border-color:#34345c;background:#101029}
.track-btn.sel{border-color:#ffd700;box-shadow:0 0 12px #ffd70066}
.track-btn.lock{opacity:.5}
button{border:2px solid #00eaff;color:#fff;background:#101a38;border-radius:9px;padding:12px 18px;font-size:14px;font-weight:bold;cursor:pointer;touch-action:none;user-select:none}
button:active{background:#075a70;transform:scale(.97)}
